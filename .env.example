# Postgres connection string (runtime only; not needed for `npm run build`)
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/applytrack"

# Session signing/encryption secret, 32+ chars. Generate: openssl rand -base64 32
AUTH_SECRET="replace-me-with-a-long-random-string-0123456789"

# Public URL of the app. Leave empty behind a reverse proxy and set AUTH_TRUST_HOST=true instead.
AUTH_URL="http://localhost:5110"
# AUTH_TRUST_HOST=true

# Show the demo credentials on the sign-in page
DEMO_MODE=true

# Set to "false" to skip creating the demo account on first start
# SEED_DEMO_DATA=true
